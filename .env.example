# ===== Backend (FastAPI) =====
APP_ENV=development
LOG_LEVEL=INFO

# Supabase — anon key is public-safe (RLS enforced); service_role is SECRET, backend only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio (Gemini) — SECRET
GEMINI_API_KEY=your-gemini-key
# gemini-2.5-flash is retired for new keys; set the current flash model.
GEMINI_MODEL=gemini-3.8-flash
# Optional OpenAI-compatible fallback (e.g. Groq). Active when LLM_BASE_URL is set.
LLM_BASE_URL=
LLM_API_KEY=your-groq-key
LLM_MODEL=openai/gpt-oss-120b

# Hugging Face (Spaces deploy / Datasets) — SECRET
HF_TOKEN=your-hf-token

# Sandbox quota guard
SANDBOX_MAX_MISS_PER_DAY=15
SANDBOX_RATE_LIMIT=5/minute

# ===== Frontend (Next.js) — NEXT_PUBLIC_* are exposed to the browser =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000